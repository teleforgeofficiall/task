# ─── TASKHUB Bot — Environment Configuration ───
# Copy this file to .env and fill in your values:
#   cp deploy/.env.example .env

# ─── Bot ───
BOT_TOKEN=your_bot_token_here
BOT_NAME=TASKHUB
BOT_USERNAME=your_bot_username
ENVIRONMENT=production
PORT=8001
WEBHOOK_URL=                   # Keep empty for polling mode

# ─── Admins ───
ADMIN_IDS=111111,222222        # Comma-separated Telegram user IDs

# ─── Database ───
DATABASE_URL=mysql+aiomysql://taskhub_user:password@localhost/taskhub_db
MYSQL_ROOT_PASSWORD=                   # MySQL root password — for auto DB creation

# ─── Runtime ───
DISABLE_TELEGRAM_NETWORK=False

# ─── Finance ───
MIN_WITHDRAW=10.0
MAX_WITHDRAW=10000.0

# ─── Security ───
FRAUD_SCORE_THRESHOLD=50
FRAUD_AUTO_BAN_THRESHOLD=100

# ─── Backup ───
BACKUP_DIR=/tmp/backups
BACKUP_RETENTION_DAYS=3
GIT_BACKUP_REPO=https://github.com/your/repo.git
GIT_BACKUP_TOKEN=your_github_pat_here
