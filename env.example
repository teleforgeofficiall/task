# ─── Bot ──────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token
BOT_NAME=TASKHUB
BOT_USERNAME=
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=8000
ENVIRONMENT=development

# ─── Admins ───────────────────────────────────────────────────────
ADMIN_IDS=123456789,987654321

# ─── Database (PostgreSQL) ────────────────────────────────────────
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=taskhub
DB_PASSWORD=changeme
DB_NAME=taskhub_db

# ─── Legacy MongoDB (optional) ────────────────────────────────────
MONGO_URL=
MONGO_MOCK=False

# ─── Runtime Flags ────────────────────────────────────────────────
DISABLE_TELEGRAM_NETWORK=False

# ─── Redis (optional) ─────────────────────────────────────────────
REDIS_URL=

# ─── Finance ──────────────────────────────────────────────────────
MIN_WITHDRAW=10.0
MAX_WITHDRAW=10000.0

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_MESSAGES=3
RATE_LIMIT_WINDOW=3
FLOOD_MUTE_SECONDS=30

# ─── Referral System ──────────────────────────────────────────────
DEFAULT_REFERRAL_MODE=random
DEFAULT_FIXED_REWARD=0.5
DEFAULT_RANDOM_MIN=0.5
DEFAULT_RANDOM_MAX=5.0

# ─── Game (Snap Pick) ──────────────────────────────────────────────
SNAP_CLOSE_HOUR=9
SNAP_CLOSE_MIN=45
SNAP_RESULT_HOUR=10
SNAP_RESULT_MIN=0
SNAP_OPEN_HOUR=10
SNAP_OPEN_MIN=30

# ─── Security ─────────────────────────────────────────────────────
FRAUD_SCORE_THRESHOLD=50
FRAUD_AUTO_BAN_THRESHOLD=100

# ─── Backup ───────────────────────────────────────────────────────
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
